{
	"name": "pronamic/pronamic-pay-doneren-met-mollie",
	"description": "Pronamic Pay plugin with Mollie.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"autoload": {
		"psr-4": {
			"Pronamic\\PronamicPayDonerenMetMollie\\": "psr-4/"
		}
	},
	"authors": [
		{
			"name": "Pronamic",
			"email": "info@pronamic.eu",
			"homepage": "https://www.pronamic.eu/",
			"role": "Developer"
		},
		{
			"name": "Remco Tolsma",
			"email": "info@remcotolsma.nl",
			"homepage": "https://www.remcotolsma.nl/",
			"role": "Developer"
		}
	],
	"config": {
		"allow-plugins": {
			"automattic/jetpack-autoloader": true,
			"composer/installers": true,
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"phpstan/extension-installer": true,
			"roots/wordpress-core-installer": true
		},
		"platform": {
			"php": "8.3"
		},
		"platform-check": false,
		"sort-packages": true
	},
	"require": {
		"php": "^8.3",
		"automattic/jetpack-autoloader": "^6.0",
		"composer/installers": "^2.3",
		"pronamic/pronamic-pay-default-payment-methods": "^1.1",
		"pronamic/wp-pronamic-forms": "^2.1",
		"woocommerce/action-scheduler": "^4.2",
		"wp-pay-gateways/mollie": "^4.22",
		"wp-pay/core": "^4.35"
	},
	"require-dev": {
		"phpstan/extension-installer": "^1.4",
		"phpstan/phpstan": "^2.3",
		"pronamic/changelog-md-to-wordpress-plugin-readme-txt": "dev-main",
		"pronamic/pronamic-cli": "^1.1",
		"pronamic/wp-coding-standards": "^2.5",
		"rector/rector": "^2.8",
		"roots/wordpress-no-content": "^7.1",
		"solvebeam/wp-text-domain-replacer": "dev-main",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"wp-cli/dist-archive-command": "*",
		"wp-cli/wp-cli-bundle": "*"
	},
	"extra": {
		"installer-paths": {
			"packages/{$vendor}/{$name}": [
				"vendor:pronamic",
				"vendor:wp-pay",
				"vendor:wp-pay-extensions",
				"vendor:wp-pay-gateways",
				"woocommerce/action-scheduler"
			]
		},
		"solvebeam-wp-text-domain-replacer": {
			"search": [
				"action-scheduler",
				"pronamic_ideal",
				"pronamic-datetime",
				"pronamic-forms",
				"pronamic-money",
				"pronamic-pay-mollie"
			],
			"replace": "pronamic-pay-doneren-met-mollie",
			"exclude": [
				"build",
				"node_modules",
				"vendor"
			]
		},
		"wp-slug": "pronamic-pay-doneren-met-mollie"
	},
	"scripts": {
		"build": [
			"Pronamic\\ChangelogMdToWordPressPluginReadmeTxt\\Synchronizer::run",
			"rm -rf ./build/stage-1",
			"rsync --recursive --verbose --exclude-from=.distignore --exclude=/vendor/ --exclude=/packages/ ./ ./build/stage-1/",
			"composer install --no-dev --prefer-dist --optimize-autoloader --working-dir=./build/stage-1/",
			"rsync --recursive --delete --delete-excluded --verbose --exclude-from=.distignore ./build/stage-1/ ./build/pronamic-pay-doneren-met-mollie/",
			"vendor/bin/wptdr --dir=./build/pronamic-pay-doneren-met-mollie/",
			"npx wp-scripts build --webpack-src-dir=./build/pronamic-pay-doneren-met-mollie/packages/pronamic/wp-pronamic-forms/blocks-src --output-path=./build/pronamic-pay-doneren-met-mollie/packages/pronamic/wp-pronamic-forms/blocks",
			"npx wp-scripts build-blocks-manifest --input=./build/pronamic-pay-doneren-met-mollie/packages/pronamic/wp-pronamic-forms/blocks --output=./build/pronamic-pay-doneren-met-mollie/packages/pronamic/wp-pronamic-forms/blocks/blocks-manifest.php",
			"vendor/bin/wp i18n make-pot ./build/pronamic-pay-doneren-met-mollie/ --slug=pronamic-pay-doneren-met-mollie",
			"vendor/bin/wp i18n make-json ./build/pronamic-pay-doneren-met-mollie/languages",
			"vendor/bin/wp i18n make-mo ./build/pronamic-pay-doneren-met-mollie/languages/",
			"vendor/bin/wp dist-archive ./build/pronamic-pay-doneren-met-mollie/ --plugin-dirname=pronamic-pay-doneren-met-mollie --force"
		],
		"make-pot": [
			"@build",
			"rsync --recursive --delete --verbose ./build/pronamic-pay-doneren-met-mollie/languages/ ./languages/",
			"vendor/bin/wp i18n update-po ./languages/pronamic-pay-doneren-met-mollie.pot"
		],
		"phpcs": "vendor/bin/phpcs",
		"phpcbf": "vendor/bin/phpcbf",
		"phpstan": "vendor/bin/phpstan analyse --memory-limit=-1",
		"rector": "vendor/bin/rector process --dry-run",
		"version": "@build"
	}
}
