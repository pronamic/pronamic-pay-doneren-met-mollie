{
	"name": "@pronamic/pronamic-pay-doneren-met-mollie",
	"version": "1.8.0",
	"description": "Pronamic Pay plugin with Mollie.",
	"author": "Pronamic",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"donation",
		"donations",
		"form",
		"forms",
		"mollie",
		"payment",
		"payment-form",
		"pronamic",
		"pronamic-pay",
		"wordpress",
		"wordpress-plugin"
	],
	"homepage": "https://github.com/pronamic/pronamic-pay-doneren-met-mollie#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pronamic/pronamic-pay-doneren-met-mollie.git"
	},
	"bugs": {
		"url": "https://github.com/pronamic/pronamic-pay-doneren-met-mollie/issues"
	},
	"dependencies": {
		"@wordpress/interactivity": "^8.1.0",
		"clsx": "^2.1.1"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.1",
		"@wordpress/e2e-test-utils-playwright": "^3.2.0",
		"@wordpress/env": "^12.1.0",
		"@wordpress/scripts": "^37.1.0"
	},
	"prettier": "@wordpress/prettier-config",
	"scripts": {
		"lint:pkg-json": "wp-scripts lint-pkg-json",
		"screenshots": "wp-scripts test-playwright --config scripts/screenshots/playwright.config.js && npm run screenshots:frame",
		"screenshots:frame": "node scripts/screenshots/frame.js",
		"video": "npm run video:tts && npm run video:record && npm run video:compose",
		"video:tts": "node scripts/video/tts.js",
		"video:record": "wp-scripts test-playwright --config scripts/video/playwright.config.js",
		"video:compose": "node scripts/video/compose.js",
		"video:review": "node scripts/video/review.js"
	}
}
